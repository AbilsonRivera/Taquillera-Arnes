#!/bin/sh
# Deja el mensaje de cada commit en una sola línea, la del asunto, como pide
# .claude/rules/flujo.md. Los commits van a nombre de quien tiene configurado git.
archivo="$1"
temporal="$archivo.asunto"
grep -v '^#' "$archivo" | grep -m 1 '[^[:space:]]' > "$temporal" || true
if [ -s "$temporal" ]; then
  cat "$temporal" > "$archivo"
fi
rm -f "$temporal"
